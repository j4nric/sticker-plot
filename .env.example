# Gemeinsames Passwort für das Ladenpersonal (Pflicht in Produktion)
APP_PASSWORD=bitte-aendern
# Zufälliger, langer Wert zum Signieren des Login-Cookies (Pflicht in Produktion), z. B. `openssl rand -hex 32`
SESSION_SECRET=bitte-aendern
# Pfad zur SQLite-Datei
DATABASE_PATH=./data/sticker-plot.db
# Fußzeile auf jedem Etikett
SHOP_NAME=Tee-Treff-Punkt
SHOP_URL=www.teetreffpunkt.de
# Optional: eigener Chromium-Pfad, sonst wird der von Playwright installierte genutzt
# CHROMIUM_PATH=/usr/bin/chromium
# Optional: auf "false" setzen, wenn die App ausnahmsweise ohne HTTPS läuft
# COOKIE_SECURE=false
